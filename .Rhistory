geom_point(alpha = 0.15) +
geom_smooth(method = "lm", se = TRUE, color = "red") +
facet_wrap(~ track_genre, scales = "free_y") +
labs(title = "Danceability vs Popularity, by Genre",
x = "Danceability", y = "Popularity")
